# dayotter self-host environment.
#
# `bash deploy/install.sh` generates a filled-in copy of this as deploy/.env with
# strong random secrets. Copy it by hand only if you're not using the installer:
#   cp deploy/.env.prod.example deploy/.env  &&  edit the REQUIRED values.
#
# After changing anything here: `cd deploy && docker compose -f docker-compose.prod.yml up -d`

# ---- REQUIRED ----------------------------------------------------------------

# Public URL people reach your dayotter at. With a domain use https://; for a
# quick IP trial use http://YOUR_SERVER_IP. Must match DAYOTTER_SITE_ADDRESS.
APP_URL=https://cal.example.com
BETTER_AUTH_URL=https://cal.example.com

# Caddy front-door address: your domain for automatic HTTPS, or ":80" for HTTP.
DAYOTTER_SITE_ADDRESS=cal.example.com

# Postgres password for the bundled database (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Datastores: bundled by default, or point at your own ----
# Leave both blank to use the Postgres + Redis that ship in this compose file.
# To use an external / managed instance instead, set its full connection URL here
# (it overrides the bundled default). With an external DATABASE_URL, POSTGRES_PASSWORD
# is unused and you can delete the `postgres` service; likewise `redis` for REDIS_URL.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/dayotter
# REDIS_URL=redis://:password@redis.example.com:6379

# 32+ char random string.        Generate: openssl rand -base64 32
AUTH_SECRET=
BETTER_AUTH_SECRET=

# 32-byte hex key for encrypting stored OAuth tokens at rest.
# Generate: openssl rand -hex 32   (the all-zero placeholder is rejected)
ENCRYPTION_KEY=

NODE_ENV=production

# ---- OPTIONAL (leave blank to disable the feature) ---------------------------

# Display brand name across the UI, page titles, and emails (default: DayOtter).
# Baked into the web build - set before `up -d --build`.
NEXT_PUBLIC_BRAND_NAME=
# Browser/PWA theme color (default: #6743e6). Baked into the web build.
NEXT_PUBLIC_BRAND_THEME_COLOR=
# Brand-variant asset overlay applied at image build (icon, PWA/OG images,
# illustrations, theme overrides). Empty = default assets in the repo; the
# directory apps/web/brand-variants/<value>/ must exist (e.g. `seemantk`).
BRAND_VARIANT=

# ---- Multi-stack hosts (two branded deploys on one machine) ----
# deploy.sh auto-includes docker-compose.local.yml, which reads these. Required
# ONLY when that file is present - set them or compose fails fast with a clear
# error instead of grabbing another stack's project name / port.
# COMPOSE_PROJECT_NAME=dayotter        # compose project (= container name prefix)
# WEB_BIND=127.0.0.1:3000              # host port your reverse proxy targets
# Distinct image tags per stack so builds never overwrite each other:
# WEB_IMAGE=dayotter-web:dayotter
# APP_IMAGE=dayotter-app:dayotter

# Google Calendar + "Sign in with Google". Redirect URI to register:
#   ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=

# Microsoft / Outlook calendar.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Outbound email (booking confirmations, reminders, password resets).
# Without it, those emails are logged to the container instead of sent.
SMTP_URL=
EMAIL_FROM="DayOtter <no-reply@example.com>"

# Email address that receives contact form submissions.
CONTACT_EMAIL=hello@dayotter.com

# AI scheduling (Anthropic). Hidden entirely when unset.
ANTHROPIC_API_KEY=

# Zoom auto-meeting for "zoom" event types.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Payments (Stripe). Paid event types are hidden unless set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMS / WhatsApp reminders (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Talk to Otter over SMS/WhatsApp + the AI voice receptionist (Twilio inbound).
# Point your Twilio number's webhooks at ${APP_URL}/api/webhooks/twilio and .../voice.
OTTER_SMS_NUMBER=              # number people text to reach Otter (defaults to TWILIO_SMS_FROM)
VOICE_RECEPTIONIST_HANDLE=    # the host handle the voice receptionist answers for (blank = off)
# TWILIO_WEBHOOK_URL=         # only if the public URL differs from APP_URL

# CRM sync (Salesforce / HubSpot). A provider is inert until BOTH id + secret set.
# OAuth callback to register: ${APP_URL}/api/integrations/crm/<provider>/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# AI voice receptionist + browser (web-push) reminders keys, if used:
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT (npx web-push generate-vapid-keys)

# Captcha on the public booking form (Cloudflare Turnstile).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# NOTE: values prefixed NEXT_PUBLIC_ are baked into the web build. Changing them
# needs a rebuild:  cd deploy && docker compose -f docker-compose.prod.yml up -d --build
